{
  "name": "filepizza",
  "version": "2.0.0",
  "description": "Free peer-to-peer file transfers in your browser.",
  "homepage": "https://github.com/kern/filepizza",
  "bugs": {
    "url": "https://github.com/kern/filepizza/issues"
  },
  "license": "BSD-3-Clause",
  "author": "Alex Kern <alex@kern.io> (http://kern.io)",
  "repository": {
    "type": "git",
    "url": "git@github.com:kern/filepizza.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "dev:full": "docker compose up redis coturn -d && COTURN_ENABLED=true REDIS_URL=redis://localhost:6379 vite dev",
    "build": "vite build",
    "start": "node .output/server/index.mjs",
    "start:peerjs": "./bin/peerjs.js",
    "lint:check": "oxlint",
    "lint:fix": "oxlint --fix",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:restart": "docker compose restart",
    "docker:clean": "docker compose down -v --rmi all",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "type:check": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "pnpm lint:check && pnpm format:check && pnpm type:check && pnpm test:coverage && pnpm build && pnpm test:e2e && pnpm docker:build"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.55.2",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.7",
    "ioredis": "^5.4.2",
    "peerjs": "^1.5.4",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-qr-code": "^2.0.15",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.3",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.2",
    "express": "^5.3.0",
    "husky": "^9.0.0",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.0.0",
    "nitro": "3.0.261103-rc",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "peer": "^1.0.2",
    "playwright": "^1.53.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.0",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ]
  },
  "engines": {
    "node": ">=24"
  }
}
